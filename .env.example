# Copia este archivo como .env y reemplaza los valores con los de tu cluster Atlas.
# Codifica caracteres especiales de la contraseña en formato URL.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=rag_nosql
VECTOR_INDEX_NAME=chunks_vector_index

# Modelo de embeddings para consultas (debe coincidir con el usado en la ingesta: 384 dimensiones).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Google Gemini para /rag. Crea la API key en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
